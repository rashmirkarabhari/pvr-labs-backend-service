# Copy to .env (or export in your shell). Never commit real secrets.
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:4200/payment/callback
CASHFREE_NOTIFY_URL=http://localhost:8085/api/payment/webhook

SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

ORDER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083
