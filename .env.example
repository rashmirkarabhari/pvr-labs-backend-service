# Copy values into your shell / IDE run config. Never commit real secrets.
# Cashfree Merchant Dashboard → Switch to Test (yellow banner) → Developers → API Keys

CASHFREE_CLIENT_ID=TEST_your_sandbox_app_id
CASHFREE_CLIENT_SECRET=cfsk_ma_test_your_sandbox_secret
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:4200/checkout?order_id={order_id}
# Must be HTTPS if set (use ngrok/cloudflare tunnel for local webhooks)
CASHFREE_NOTIFY_URL=

SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

ORDER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083

# Order confirmation emails (admin + customer). Leave MAIL_ENABLED=false to log instead of send.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@pvrlabs.com
MAIL_FROM_NAME=PVR 3D Labs
MAIL_ADMIN_TO=hello@pvr3dlabs.com
